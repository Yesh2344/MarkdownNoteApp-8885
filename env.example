# .env.example – copy to .env and edit values as needed

# Directory where markdown notes will be stored.
# Example: /home/user/markdown_notes
NOTES_DIR="${HOME}/markdown_notes"

# Log file path.
# Example: /home/user/markdown_note_app.log
LOG_FILE="${HOME}/markdown_note_app.log"

# Log level (INFO, WARN, ERROR)
LOG_LEVEL="INFO"